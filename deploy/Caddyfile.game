# ── Вставить в /home/workaem/deploy/Caddyfile, отдельным блоком в конец ──

# Игра «Путь джуна» — статика на отдельном поддомене.
#
# Отдельный домен, а не путь на APP_DOMAIN: игру открывают как Telegram
# Mini App, а он требует, чтобы весь ресурс жил на одном HTTPS-хосте.
# Держать её на www значило бы примешивать статику к роутингу Next.js.
#
# Дефолт в подстановке — по той же причине, что у ROOT_DOMAIN: переменной
# нет в .env на ВМ, и без дефолта Caddy прочитал бы пустой адрес сайта
# и не поднялся бы вовсе.
#
# Условие работы блока то же, что у апекса: A-запись game.workaem.com
# должна указывать на эту ВМ, иначе ACME не подтвердит домен и Caddy
# будет ретраить в логах, не мешая остальным сайтам.
{$GAME_DOMAIN:game.workaem.com} {
	encode zstd gzip
	root * /srv/junior-way
	file_server

	header Strict-Transport-Security "max-age=31536000"

	# Имена файлов в /assets содержат хеш сборки, поэтому их можно
	# кешировать навсегда: изменится содержимое — изменится и имя.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# index.html, наоборот, не кешируем. Ссылка на игру одна и та же,
	# меняется только содержимое — с кешем игроки застряли бы на старой
	# версии и не увидели ни новых уровней, ни исправлений.
	@html path /
	header @html Cache-Control "no-cache"
}
